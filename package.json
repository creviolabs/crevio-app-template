{
	"name": "crevio-app-template",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"build": "bun run typecheck && vite build",
		"preflight": "node --test test/smoke.test.ts",
		"cf-typegen": "wrangler types",
		"deploy": "bun run build && wrangler deploy",
		"dev": "vite dev",
		"start": "vite preview",
		"postinstall": "bun run cf-typegen",
		"typecheck": "bun run cf-typegen && tsc",
		"check": "biome check --write --unsafe .",
		"test": "node --test test/*.test.ts"
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@crevio/sdk": "0.6.5",
		"@crevio/vite-plugins": "^0.1.4",
		"@fontsource-variable/geist": "^5.3.0",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-router": "^1.170.30",
		"@tanstack/react-start": "^1.168.47",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"embla-carousel-react": "^8.6.0",
		"framer-motion": "^13.0.0",
		"input-otp": "^1.4.2",
		"lucide-react": "^1.29.0",
		"next-themes": "^0.4.6",
		"react": "^19.2.8",
		"react-day-picker": "^9.14.0",
		"react-dom": "^19.2.8",
		"react-resizable-panels": "^4.12.2",
		"recharts": "3.10.1",
		"shadcn": "^4.16.2",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"tailwindcss-animate": "^1.0.7",
		"tw-animate-css": "^1.4.0",
		"vaul": "^1.1.2",
		"workers-og": "^0.0.27",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.9",
		"@cloudflare/vite-plugin": "^1.51.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.3.14",
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.2.1",
		"wrangler": "^4.119.0"
	}
